# Estratto delle allerte DPC pubblicato dal job schedulato (bucket pubblico).
# Senza questa variabile l'app funziona lo stesso, scaricando il bollettino
# direttamente da GitHub: più pesante e soggetto al limite di 60 richieste/ora
# per IP della loro API.
VITE_DPC_EXTRACT_URL=https://<progetto>.supabase.co/storage/v1/object/public/dpc/latest.json
